<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server/app.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="antique-mall" patternSyntax="Wildcard" stopProcessing="true">
          <match url="*" />
          <action type="Rewrite" url="server/app.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode watchedFiles="*.js" nodeProcessCommandLine="node.exe" />
  </system.webServer>
</configuration>
